name = "moonrockz/pretty"

version = "0.1.0"

import {
  "moonrockz/expect@0.6.0",
}

repository = "https://github.com/moonrockz/krueger"

license = "Apache-2.0"

keywords = [ "pretty-printer", "wadler", "layout", "document" ]

description = "Wadler-style pretty printer for MoonBit: documents, groups and layout that fits a line width"

source = "src"

warnings = "-implicit_impl_as_method"
