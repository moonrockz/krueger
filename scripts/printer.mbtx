----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonrockz/moonspec@0.11.0",
  "moonrockz/expect@0.6.1",
}
----

///|
/// Record elm-format 0.8.7 verdicts for the printed corpus.
///
/// Usage: printer.mbtx record <printed-dir> <lock> [<pending.json>]
///
/// For each `.elm` file under `<printed-dir>` (written by
/// `KRUEGER_PARITY_MODE=write-printed`), the lock holds the file's SHA-256
/// and whether `elm-format --validate` accepts it (`stable`) or would change
/// it (`changed`). Any other elm-format exit code, or a directory with no
/// `.elm` file, stops the script with an error and writes nothing. With
/// `<pending.json>`, the script also writes the changed files there; use it
/// only to start or reset the list.
/// Only exact first/second hash pairs in `tests/printer/oracle_transitions.json`
/// get the verdict `oracle_second_pass`. Recording never changes those pins.

///|
let usage : String = "Usage: printer.mbtx record <printed-dir> <lock> [<pending.json>]"

///|
struct Verdict {
  key : String
  sha256 : String
  stable : Bool
  oracle_second : String?
}

///|
fn recorded_verdict(
  key : String,
  first : String,
  stable : Bool,
  second : String,
  transitions : Json,
) -> Verdict {
  let oracle_second = if stable {
    None
  } else {
    match expected_second(transitions, key, first) {
      Some(expected) if second == expected => Some(second)
      _ => None
    }
  }
  { key, sha256: first, stable, oracle_second, }
}

///|
/// The pinned next hash, only when this key and its current printed bytes
/// match a known first pass. Unrelated changes cannot update the pin.
fn expected_second(transitions : Json, key : String, first : String) -> String? {
  guard transitions is Object(entries) &&
    entries.get(key) is Some(Object(entry)) &&
    entry.get("first") is Some(String(known_first)) &&
    entry.get("second") is Some(String(second)) &&
    first == known_first &&
    first != second else {
    return None
  }
  Some(second)
}

///|
/// The lock file text, entries in the order given.
fn lock_text(verdicts : Array[Verdict]) -> String {
  let entries : Map[String, Json] = Map([])
  for v in verdicts {
    let entry : Map[String, Json] = {
      "sha256": Json(v.sha256),
      "elm_format": Json(
        if v.stable {
          "stable"
        } else if v.oracle_second is Some(_) {
          "oracle_second_pass"
        } else {
          "changed"
        },
      ),
    }
    if v.oracle_second is Some(hash) {
      entry["second"] = Json(hash)
    }
    entries[v.key] = Json::object(entry)
  }
  Json::object(entries).stringify(indent=2) + "\n"
}

///|
/// The pending list text: the keys of the changed files.
fn pending_text(verdicts : Array[Verdict]) -> String {
  let keys : Array[Json] = []
  for v in verdicts {
    if !v.stable && v.oracle_second is None {
      keys.push(Json(v.key))
    }
  }
  Json::array(keys).stringify(indent=2) + "\n"
}

///|
/// The verdict for an `elm-format --validate` exit code: 0 is stable
/// (`Some(true)`) and 1 is changed (`Some(false)`). Any other code means
/// that elm-format did not run or failed (`None`).
fn validate_verdict(code : Int32) -> Bool? {
  match code {
    0 => Some(true)
    1 => Some(false)
    _ => None
  }
}

///|
fn sha256_hex(text : String) -> String {
  @hex.encode(Bytes::from_array(@crypto.sha256(@utf8.encode(text))))
}

///|
/// Recursively list `.elm` files under `dir`, as paths relative to `dir`, sorted.
async fn elm_files(dir : String) -> Array[String] {
  let found = []
  async fn go(rel : String) -> Unit {
    let full = if rel == "" { dir } else { "\{dir}/\{rel}" }
    for entry in @fs.readdir(full, sort=true) {
      let child = if rel == "" { entry } else { "\{rel}/\{entry}" }
      match @fs.kind("\{dir}/\{child}") {
        Directory => go(child)
        Regular => if child.has_suffix(".elm") { found.push(child) }
        _ => ()
      }
    }
  }
  go("")
  found.sort_by(compare_lexical)
  found
}

///|
/// Compare strings by code unit (`String::compare` compares length first).
fn compare_lexical(a : String, b : String) -> Int32 {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let c = a.code_unit_at(i).compare(b.code_unit_at(i))
    if c != 0 {
      return c
    }
  }
  a.length().compare(b.length())
}

///|
async fn record(dir : String, lock : String, pending : String?) -> Unit {
  let transitions = @fs.read_file("tests/printer/oracle_transitions.json").json()
  let verdicts = []
  let files = elm_files(dir)
  if files.is_empty() {
    eprintln(
      "printer: no .elm file under \{dir}; run mise run corpus:fetch, then mise run printer:record",
    )
    @sys.exit(1)
  }
  for file in files {
    let path = "\{dir}/\{file}"
    let (code, _, err) = @process.collect_output("mise", [
      "x", "github:avh4/elm-format@0.8.7", "--", "elm-format", "--validate", path,
    ])
    guard validate_verdict(code) is Some(stable) else {
      eprintln(
        "printer: elm-format exited with code \{code} for \{path}:\n\{err.text()}",
      )
      @sys.exit(1)
    }
    let first = sha256_hex(@fs.read_file(path).text())
    let second = if !stable &&
      expected_second(transitions, file, first) is Some(_) {
      let (code, output) = @process.collect_stdout(
        "mise",
        [
          "x", "github:avh4/elm-format@0.8.7", "--", "elm-format", "--stdin", "--elm-version=0.19",
        ],
        stdin=@process.redirect_from_file(path),
      )
      if code != 0 {
        eprintln("printer: elm-format rejected the printed text for \{file}")
        @sys.exit(1)
      }
      sha256_hex(output.text())
    } else {
      ""
    }
    verdicts.push(recorded_verdict(file, first, stable, second, transitions))
  }
  @fs.write_file(lock, lock_text(verdicts))
  let changed = verdicts
    .filter(v => !v.stable && v.oracle_second is None)
    .length()
  let second = verdicts.filter(v => v.oracle_second is Some(_)).length()
  println(
    "printer: \{verdicts.length() - changed - second} stable, \{second} oracle second pass, \{changed} changed; wrote \{lock}",
  )
  if pending is Some(p) {
    @fs.write_file(p, pending_text(verdicts))
    println("printer: wrote \{p}")
  }
}

///|
async fn main {
  match @env.args()[1:] {
    ["record", dir, lock] => record(dir, lock, None)
    ["record", dir, lock, pending] => record(dir, lock, Some(pending))
    _ => {
      eprintln(usage)
      @sys.exit(2)
    }
  }
}

///|
/// Scenario state for `features/printer.feature`.
struct PrinterLockWorld {
  verdicts : Array[Verdict]
  mut transitions : Json
  mut candidate : (String, String, Bool, String)?
}

///|
fn PrinterLockWorld::new() -> PrinterLockWorld {
  { verdicts: [], transitions: Json::object(Map([])), candidate: None, }
}

///|
impl @moonspec.World for PrinterLockWorld with fn configure(self, setup) {
  setup.given1("the known oracle transitions:", fn(
    doc : @moonspec.DocString,
  ) raise {
    self.transitions = @json.parse(doc.content)
  })
  setup.given1("the printed candidate:", fn(table : @moonspec.DataTable) {
    let row = table.as_maps()[0]
    self.candidate = Some(
      (
        row.get("key").unwrap_or(""),
        row.get("sha256").unwrap_or(""),
        row.get("stable") == Some("yes"),
        row.get("formatted").unwrap_or(""),
      ),
    )
  })
  setup.when0("I classify the printed candidate", fn() {
    let (key, first, stable, second) = self.candidate.unwrap()
    self.verdicts.push(
      recorded_verdict(key, first, stable, second, self.transitions),
    )
  })
  setup.then1("the recorded verdict is {string}", fn(expected : String) raise {
    guard @json.parse(lock_text(self.verdicts)) is Object(entries) &&
      entries.get(self.candidate.unwrap().0) is Some(Object(entry)) else {
      fail("no lock entry for the candidate")
    }
    @expect.expect(entry.get("elm_format")).to_equal(Some(Json(expected)))
  })
  setup.then1("the pending keys are {string}", fn(expected : String) raise {
    let keys : Array[Json] = if expected == "" {
      []
    } else {
      expected.split(",").map(k => Json(k.to_owned())).collect()
    }
    @expect.expect(@json.parse(pending_text(self.verdicts))).to_equal(
      Json::array(keys),
    )
  })
  setup.given1("the verdicts:", fn(table : @moonspec.DataTable) {
    // as_maps() keys each row by the header row.
    for row in table.as_maps() {
      self.verdicts.push({
        key: row.get("key").unwrap_or(""),
        sha256: row.get("sha256").unwrap_or(""),
        stable: row.get("stable") == Some("yes"),
        oracle_second: row.get("second"),
      })
    }
  })
  setup.then1("the lock is:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(lock_text(self.verdicts)).to_equal(doc.content + "\n")
  })
  setup.then1("the pending list is:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(pending_text(self.verdicts)).to_equal(doc.content + "\n")
  })
  setup.then1("the elm-format exit codes give:", fn(
    table : @moonspec.DataTable,
  ) raise {
    @expect.expect_all(s => {
      for row in table.as_maps() {
        let code = @string.parse_int(row.get("code").unwrap_or(""))
        let verdict = match validate_verdict(code) {
          Some(true) => "stable"
          Some(false) => "changed"
          None => "error"
        }
        s
        .expect((code, verdict))
        .to_equal((code, row.get("verdict").unwrap_or("")))
      }
    })
  })
}

///|
async test "printer feature" {
  @moonspec.run_or_fail(
    PrinterLockWorld::new,
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/printer.feature"),
    ]),
  )
  |> ignore
}
