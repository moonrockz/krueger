///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/process",
  "moonrockz/moonspec@0.7.1",
  "moonrockz/expect@0.2.0",
}

///|
/// Print the next version from conventional commits (git-cliff),
/// or the initial version when git-cliff cannot compute one.

///|
let initial_version : String = "v0.1.0"

///|
/// Pick the version to print from the git-cliff exit code and stdout.
fn choose_version(exit_code : Int, stdout : String) -> String {
  let version = stdout.trim().to_owned()
  if exit_code == 0 && version != "" {
    version
  } else {
    initial_version
  }
}

///|
async fn main {
  let (code, out) = @process.collect_stdout(
    "git",
    ["cliff", "--bumped-version"],
    stderr=@process.redirect_to_file("/dev/null"),
  ) catch {
    _ => (1, b"")
  }
  println(choose_version(code, out.text()))
}

///|
/// Scenario state for `features/version.feature`.
struct VersionWorld {
  mut exit_code : Int
  mut stdout : String
}

///|
fn VersionWorld::new() -> VersionWorld {
  { exit_code: 0, stdout: "", }
}

///|
impl @moonspec.World for VersionWorld with fn configure(self, setup) {
  setup.given2("git-cliff exits with {int} and prints {string}", fn(
    code : Int,
    stdout : String,
  ) {
    self.exit_code = code
    self.stdout = stdout
  })
  setup.then1("the printed version is {string}", fn(expected : String) raise {
    @expect.expect(choose_version(self.exit_code, self.stdout)).to_equal(
      expected,
    )
  })
}

///|
async test "version feature" {
  @moonspec.run_or_fail(
    VersionWorld::new,
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/version.feature"),
    ]),
  )
  |> ignore
}
