///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonrockz/moonspec@0.7.1",
  "moonrockz/expect@0.2.0",
}

///|
/// Generate the lexer's Unicode identifier table from UnicodeData.txt.
///
/// Usage: unicode_table.mbtx <UnicodeData.txt> <version> <out.mbt>
///
/// Classes: a lower-case name starts with Ll; an upper-case name starts with
/// Lu or Lt; later characters are any letter (L*) or number (N*). The lexer
/// narrows these per dialect with the `titlecase` (Lt) and `number`
/// (non-ASCII N*) tables: elm make allows only ASCII digits in names, and
/// elm-syntax does not let Lt start a name.

///|
let usage : String = "Usage: unicode_table.mbtx <UnicodeData.txt> <version> <out.mbt>"

///|
/// Code point ranges per class, each as inclusive (start, end) pairs, sorted
/// and merged.
struct Classes {
  lower_start : Array[(Int, Int)]
  upper_start : Array[(Int, Int)]
  inner : Array[(Int, Int)]
  titlecase : Array[(Int, Int)]
  number : Array[(Int, Int)]
}

///|
fn add(ranges : Array[(Int, Int)], start : Int, end : Int) -> Unit {
  match ranges.last() {
    Some((s, e)) if start <= e + 1 =>
      ranges[ranges.length() - 1] = (s, if end > e { end } else { e })
    _ => ranges.push((start, end))
  }
}

///|
/// Classes from the text of UnicodeData.txt (lines in code point order).
fn classes(data : String) -> Classes raise {
  let lower_start = []
  let upper_start = []
  let inner = []
  let titlecase = []
  let number = []
  let mut range_start : Int? = None
  for raw in data.split("\n") {
    let line = raw.trim().to_owned()
    if line == "" {
      continue
    }
    let fields = line.split(";").map(f => f.to_owned()).collect()
    guard fields is [code_text, name, category, ..] else {
      fail("UnicodeData: malformed line: \{line}")
    }
    let code = @string.parse_int(code_text, base=16)
    if name.has_suffix(", First>") {
      range_start = Some(code)
      continue
    }
    let start = match range_start {
      Some(s) if name.has_suffix(", Last>") => s
      _ => code
    }
    range_start = None
    if category == "Ll" {
      add(lower_start, start, code)
    }
    if category == "Lu" || category == "Lt" {
      add(upper_start, start, code)
    }
    if category.has_prefix("L") || category.has_prefix("N") {
      add(inner, start, code)
    }
    if category == "Lt" {
      add(titlecase, start, code)
    }
    if category.has_prefix("N") && start >= 0x80 {
      add(number, start, code)
    }
  }
  { lower_start, upper_start, inner, titlecase, number, }
}

///|
fn hex4(n : Int) -> String {
  let digits = "0123456789ABCDEF"
  let sb = StringBuilder()
  let mut shift = if n > 0xFFFF { 20 } else { 12 }
  while shift >= 0 {
    sb.write_char(digits.get_char((n >> shift) & 15).unwrap())
    shift -= 4
  }
  sb.to_string()
}

///|
fn describe(ranges : Array[(Int, Int)]) -> String {
  ranges.map(r => "\{hex4(r.0)}-\{hex4(r.1)}").join(", ")
}

///|
fn table(name : String, ranges : Array[(Int, Int)]) -> String {
  let sb = StringBuilder()
  sb.write_string("///|\nlet \{name} : FixedArray[Int] = [\n")
  for r in ranges {
    sb.write_string("  0x\{hex4(r.0)}, 0x\{hex4(r.1)},\n")
  }
  sb.write_string("]\n")
  sb.to_string()
}

///|
/// The generated MoonBit source.
fn source(c : Classes, version : String) -> String {
  "///|\n/// Unicode \{version} code point ranges for identifiers, as inclusive\n/// start/end pairs. Generated by scripts/unicode_table.mbtx\n/// (mise run unicode:generate); do not edit.\n\n" +
  table("lower_start_ranges", c.lower_start) +
  "\n" +
  table("upper_start_ranges", c.upper_start) +
  "\n" +
  table("inner_ranges", c.inner) +
  "\n" +
  table("titlecase_ranges", c.titlecase) +
  "\n" +
  table("number_ranges", c.number)
}

///|
async fn main {
  guard @env.args()[1:] is [input, version, out] else {
    eprintln(usage)
    @sys.exit(2)
    return
  }
  let c = classes(@fs.read_file(input).text())
  @fs.write_file(out, source(c, version))
  println(
    "unicode: \{c.lower_start.length()} lower, \{c.upper_start.length()} upper, \{c.inner.length()} inner ranges -> \{out}",
  )
}

///|
struct UnicodeWorld {
  mut data : String
}

///|
impl @moonspec.World for UnicodeWorld with fn configure(self, setup) {
  setup.given1("the Unicode data:", fn(doc : @moonspec.DocString) {
    self.data = doc.content
  })
  setup.then1("the lower-start ranges are {string}", fn(
    expected : String,
  ) raise {
    @expect.expect(describe(classes(self.data).lower_start)).to_equal(expected)
  })
  setup.then1("the upper-start ranges are {string}", fn(
    expected : String,
  ) raise {
    @expect.expect(describe(classes(self.data).upper_start)).to_equal(expected)
  })
  setup.then1("the inner ranges are {string}", fn(expected : String) raise {
    @expect.expect(describe(classes(self.data).inner)).to_equal(expected)
  })
  setup.then1("the title-case ranges are {string}", fn(
    expected : String,
  ) raise {
    @expect.expect(describe(classes(self.data).titlecase)).to_equal(expected)
  })
  setup.then1("the non-ASCII number ranges are {string}", fn(
    expected : String,
  ) raise {
    @expect.expect(describe(classes(self.data).number)).to_equal(expected)
  })
}

///|
async test "unicode table feature" {
  @moonspec.run_or_fail(
    () => UnicodeWorld::{ data: "", },
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/unicode_table.feature"),
    ]),
  )
  |> ignore
}
