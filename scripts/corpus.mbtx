///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/hex",
  "moonrockz/moonspec@0.7.1",
  "moonrockz/expect@0.2.0",
}

///|
/// Elm parity corpus: build the manifest, fetch and verify pinned pkgs.
///
/// Usage:
///   corpus.mbtx manifest <packages.txt> <manifest.json>
///   corpus.mbtx fetch <manifest.json> <corpus-dir>

///|
let usage : String = "Usage: corpus.mbtx manifest <packages.txt> <manifest.json> | fetch <manifest.json> <corpus-dir>"

///|
struct Pkg {
  name : String
  version : String
} derive(Eq, Debug)

///|
struct PackageEntry {
  pkg : Pkg
  zipball : String
  zip_sha1 : String
  files : Array[(String, String)]
} derive(Eq, Debug)

///|
/// Parse `author/name@1.2.3` lines; blank lines and `#` comments are ignored.
fn parse_packages(text : String) -> Result[Array[Pkg], String] {
  let pkgs = []
  for raw in text.split("\n") {
    let line = raw.trim().to_owned()
    if line == "" || line.has_prefix("#") {
      continue
    }
    match line.split_once("@") {
      Some((name, version)) if name.contains("/") && version != "" =>
        pkgs.push({ name: name.to_owned(), version: version.to_owned(), })
      _ => return Err("invalid package line: \{line}")
    }
  }
  Ok(pkgs)
}

///|
/// Lowercase hex encoding of a digest.
fn hex(digest : FixedArray[Byte]) -> String {
  @hex.encode(Bytes::from_array(digest))
}

///|
fn package_dir(corpus : String, pkg : Pkg) -> String {
  "\{corpus}/\{pkg.name}@\{pkg.version}"
}

///|
fn manifest_json(entries : Array[PackageEntry]) -> Json {
  let pkgs = entries.map(e => {
    let files = e.files.map(f => {
      let (path, sha256) = f
      let file : Json = { "path": path.to_json(), "sha256": sha256.to_json() }
      file
    })
    let entry : Json = {
      "name": e.pkg.name.to_json(),
      "version": e.pkg.version.to_json(),
      "zipball": e.zipball.to_json(),
      "sha1": e.zip_sha1.to_json(),
      "files": Json::array(files),
    }
    entry
  })
  { "elm": "0.19.1".to_json(), "packages": Json::array(pkgs) }
}

///|
fn parse_manifest(json : Json) -> Array[PackageEntry] raise {
  guard json is Object(root) && root.get("packages") is Some(Array(items)) else {
    fail("manifest: missing packages array")
  }
  items.map(item => {
    guard item is Object(p) &&
      p.get("name") is Some(String(name)) &&
      p.get("version") is Some(String(version)) &&
      p.get("zipball") is Some(String(zipball)) &&
      p.get("sha1") is Some(String(sha1)) &&
      p.get("files") is Some(Array(files)) else {
      fail("manifest: malformed package entry")
    }
    let files = files.map(f => {
      guard f is Object(fo) &&
        fo.get("path") is Some(String(path)) &&
        fo.get("sha256") is Some(String(sha)) else {
        fail("manifest: malformed file entry in \{name}")
      }
      (path, sha)
    })
    { pkg: { name, version, }, zipball, zip_sha1: sha1, files, }
  })
}

///|
async fn run_or_exit(cmd : String, args : Array[String]) -> Unit {
  let code = @process.run(cmd, args)
  if code != 0 {
    eprintln("\{cmd} failed with exit code \{code}")
    @sys.exit(code)
  }
}

///|
/// Recursively list `.elm` files under `dir`, as paths relative to `dir`, sorted.
async fn elm_files(dir : String) -> Array[String] {
  let found = []
  async fn go(rel : String) -> Unit {
    let full = if rel == "" { dir } else { "\{dir}/\{rel}" }
    for entry in @fs.readdir(full, sort=true) {
      let child = if rel == "" { entry } else { "\{rel}/\{entry}" }
      match @fs.kind("\{dir}/\{child}") {
        Directory => go(child)
        Regular => if child.has_suffix(".elm") { found.push(child) }
        _ => ()
      }
    }
  }
  go("")
  found
}

///|
/// Download and extract one pkg's `src/` into `<corpus>/<name>@<version>/src`.
async fn download(corpus : String, entry : PackageEntry) -> Unit {
  let zip = "\{corpus}/_zips/\{entry.pkg.name.replace_all(old="/", new="__")}@\{entry.pkg.version}.zip"
  @fs.mkdir("\{corpus}/_zips", recursive=true, allow_exist=true)
  run_or_exit("curl", ["-fsSL", "-o", zip, entry.zipball])
  let sha1 = hex(@crypto.sha1(@fs.read_file(zip).binary()))
  if sha1 != entry.zip_sha1 {
    eprintln(
      "\{entry.pkg.name}@\{entry.pkg.version}: zip sha1 \{sha1} != \{entry.zip_sha1}",
    )
    @sys.exit(1)
  }
  let staging = "\{corpus}/_staging"
  if @fs.exists(staging) {
    @fs.rmdir(staging, recursive=true)
  }
  run_or_exit("unzip", ["-q", "-o", zip, "-d", staging])
  guard @fs.readdir(staging) is [root] else {
    eprintln("\{zip}: expected one root directory")
    @sys.exit(1)
    return
  }
  let target = package_dir(corpus, entry.pkg)
  if @fs.exists(target) {
    @fs.rmdir(target, recursive=true)
  }
  @fs.mkdir(target, recursive=true)
  @fs.rename("\{staging}/\{root}/src", "\{target}/src")
  @fs.rmdir(staging, recursive=true)
}

///|
async fn endpoint(pkg : Pkg) -> (String, String) {
  let url = "https://package.elm-lang.org/packages/\{pkg.name}/\{pkg.version}/endpoint.json"
  let (code, out) = @process.collect_stdout("curl", ["-fsSL", url])
  if code != 0 {
    eprintln("cannot fetch \{url}")
    @sys.exit(1)
  }
  guard out.json() is Object(e) &&
    e.get("url") is Some(String(zip)) &&
    e.get("hash") is Some(String(sha1)) else {
    fail("unexpected endpoint.json for \{pkg.name}")
  }
  (zip, sha1)
}

///|
async fn build_manifest(packages_file : String, manifest : String) -> Unit {
  let pkgs = match parse_packages(@fs.read_file(packages_file).text()) {
    Ok(p) => p
    Err(message) => {
      eprintln(message)
      @sys.exit(2)
      return
    }
  }
  let corpus = ".corpus"
  let entries = []
  for pkg in pkgs {
    let (zipball, zip_sha1) = endpoint(pkg)
    let entry = { pkg, zipball, zip_sha1, files: [], }
    download(corpus, entry)
    let src = "\{package_dir(corpus, pkg)}/src"
    let files = []
    for rel in elm_files(src) {
      files.push(
        (
          "src/\{rel}",
          hex(@crypto.sha256(@fs.read_file("\{src}/\{rel}").binary())),
        ),
      )
    }
    entries.push({ ..entry, files, })
    println("\{pkg.name}@\{pkg.version}: \{files.length()} files")
  }
  @fs.write_file(manifest, manifest_json(entries).stringify(indent=2) + "\n")
}

///|
async fn fetch(manifest : String, corpus : String) -> Unit {
  let entries = parse_manifest(@fs.read_file(manifest).json())
  let mut bad = 0
  for entry in entries {
    let dir = package_dir(corpus, entry.pkg)
    let mut complete = true
    for f in entry.files {
      if !@fs.exists("\{dir}/\{f.0}") {
        complete = false
      }
    }
    if !complete {
      download(corpus, entry)
    }
    for f in entry.files {
      let (path, expected) = f
      let full = "\{dir}/\{path}"
      if !@fs.exists(full) {
        eprintln("missing: \{full}")
        bad += 1
      } else if hex(@crypto.sha256(@fs.read_file(full).binary())) != expected {
        eprintln("sha256 mismatch: \{full}")
        bad += 1
      }
    }
  }
  if bad > 0 {
    @sys.exit(1)
  }
  println("corpus ok: \{entries.length()} packages")
}

///|
async fn main {
  match @env.args()[1:] {
    ["manifest", pkgs, manifest] => build_manifest(pkgs, manifest)
    ["fetch", manifest, corpus] => fetch(manifest, corpus)
    _ => {
      eprintln(usage)
      @sys.exit(2)
    }
  }
}

///|
/// Scenario state for `features/corpus.feature`.
struct CorpusWorld {
  mut text : String
  mut pkgs : Result[Array[Pkg], String]
  mut entry : PackageEntry?
  mut round_trip : Result[Array[PackageEntry], String]
}

///|
fn CorpusWorld::new() -> CorpusWorld {
  { text: "", pkgs: Ok([]), entry: None, round_trip: Ok([]), }
}

///|
impl @moonspec.World for CorpusWorld with fn configure(self, setup) {
  setup.given1("the package list:", fn(doc : @moonspec.DocString) {
    self.text = doc.content
  })
  setup.when0("I read the package list", fn() {
    self.pkgs = parse_packages(self.text)
  })
  setup.then1("the packages are {string}", fn(expected : String) raise {
    guard self.pkgs is Ok(pkgs) else { fail("expected packages") }
    @expect.expect(pkgs.map(p => "\{p.name}@\{p.version}").join(", ")).to_equal(
      expected,
    )
  })
  setup.then1("reading fails with {string}", fn(message : String) raise {
    @expect.expect(self.pkgs).to_equal(Err(message))
  })
  setup.given3(
    "a manifest entry for {string} with file {string} hashed {string}",
    fn(coordinate : String, path : String, sha : String) raise {
      guard parse_packages(coordinate) is Ok([pkg]) else {
        fail("bad coordinate")
      }
      self.entry = Some({
        pkg,
        zipball: "https://example.test/zip",
        zip_sha1: "0",
        files: [(path, sha)],
      })
    },
  )
  setup.when0("I write and read the manifest", fn() {
    guard self.entry is Some(entry) else { return }
    self.round_trip = try parse_manifest(manifest_json([entry])) catch {
      err => Err(err.to_string())
    } noraise {
      entries => Ok(entries)
    }
  })
  setup.then0("the manifest entry is unchanged", fn() raise {
    guard self.entry is Some(entry) else { fail("no entry") }
    @expect.expect(self.round_trip).to_equal(Ok([entry]))
  })
}

///|
async test "corpus feature" {
  @moonspec.run_or_fail(
    CorpusWorld::new,
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/corpus.feature"),
    ]),
  )
  |> ignore
}
