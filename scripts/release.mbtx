///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonrockz/moonspec@0.7.1",
  "moonrockz/expect@0.6.0",
}

///|
/// Release tooling. A release is a pull request that sets the version in
/// moon.mod and adds its section to CHANGELOG.md; when it merges, the Release
/// workflow tags the commit, publishes to mooncakes.io and creates the GitHub
/// release from that section.
///
/// Usage:
///   release.mbtx version              print the next version (git-cliff)
///   release.mbtx prepare [<version>] [--local]
///                                     open the release pull request
///   release.mbtx plan                 decide in CI whether to release
///   release.mbtx notes <version>      print the GitHub release notes
///   release.mbtx refresh              update the release pull request body
///   release.mbtx status               check main, tags, GitHub and mooncakes.io

///|
let usage : String = "Usage: release.mbtx version | prepare [<version>] [--local] | plan | notes <version> | refresh | status"

///|
let initial_version : String = "v0.1.0"

///|
let module_name : String = "moonrockz/krueger"

///|
let changelog_path : String = "CHANGELOG.md"

///|
/// The file whose `version()` returns the module version.
let lib_path : String = "src/lib.mbt"

///|
/// Pick the version to print from the git-cliff exit code and stdout.
fn choose_version(exit_code : Int, stdout : String) -> String {
  let version = stdout.trim().to_owned()
  if exit_code == 0 && version != "" {
    version
  } else {
    initial_version
  }
}

///|
/// A `major.minor.patch` version.
struct Version {
  major : Int
  minor : Int
  patch : Int
} derive(Eq, Compare, Debug)

///|
impl Show for Version with fn output(self, logger) {
  logger.write_string("\{self.major}.\{self.minor}.\{self.patch}")
}

///|
fn parse_number(text : StringView) -> Int? {
  guard text.length() > 0 && text.length() <= 9 else { return None }
  let mut n = 0
  for c in text {
    guard c >= '0' && c <= '9' else { return None }
    n = n * 10 + (c.to_int() - '0'.to_int())
  }
  Some(n)
}

///|
/// Read `1.2.3` or `v1.2.3`. Pre-release and build suffixes are not used here.
fn parse_version(text : String) -> Result[Version, String] {
  let trimmed = text.trim()
  let bare = if trimmed.has_prefix("v") {
    trimmed.view(start_offset=1)
  } else {
    trimmed
  }
  let parts = bare.split(".").collect()
  match parts {
    [major, minor, patch] =>
      match (parse_number(major), parse_number(minor), parse_number(patch)) {
        (Some(major), Some(minor), Some(patch)) => Ok({ major, minor, patch, })
        _ => Err("not a version: \{text}")
      }
    _ => Err("not a version: \{text}")
  }
}

///|
/// The `version = "..."` value of a moon.mod file.
fn mod_version(moon_mod : String) -> String? {
  for line in moon_mod.split("\n") {
    if version_value(line) is Some(value) {
      return Some(value)
    }
  }
  None
}

///|
fn version_value(line : StringView) -> String? {
  let line = line.trim()
  guard line.has_prefix("version") else { return None }
  let rest = line.view(start_offset=7).trim_start()
  guard rest.has_prefix("=") else { return None }
  let value = rest.view(start_offset=1).trim()
  guard value.length() >= 2 && value.has_prefix("\"") && value.has_suffix("\"") else {
    return None
  }
  Some(value.view(start_offset=1, end_offset=value.length() - 1).to_owned())
}

///|
/// src/lib.mbt with the string that `version()` returns set to `version`, or
/// `None` when it has no `pub fn version() -> String` whose body is one
/// string literal.
fn set_lib_version(lib : String, version : Version) -> String? {
  let lines = lib.split("\n").map(l => l.to_owned()).collect()
  for i, line in lines {
    if line.trim() == "pub fn version() -> String {" && i + 1 < lines.length() {
      let body = lines[i + 1].trim()
      guard body.length() >= 2 && body.has_prefix("\"") && body.has_suffix("\"") else {
        return None
      }
      lines[i + 1] = "  \"\{version}\""
      return Some(lines.join("\n"))
    }
  }
  None
}

///|
/// moon.mod with its version set to `version`, or `None` when it has no
/// version line.
fn set_mod_version(moon_mod : String, version : Version) -> String? {
  let lines = moon_mod.split("\n").map(l => l.to_owned()).collect()
  for i, line in lines {
    if version_value(line) is Some(_) {
      lines[i] = "version = \"\{version}\""
      return Some(lines.join("\n"))
    }
  }
  None
}

///|
/// The version that `prepare` releases: the one asked for, or else the one
/// git-cliff computes. It must be above the version in moon.mod.
fn release_version(
  requested : String?,
  computed : String,
  current : String,
) -> Result[Version, String] {
  guard parse_version(current) is Ok(current) else {
    return Err("moon.mod has a bad version: \{current}")
  }
  let next = match parse_version(requested.unwrap_or(computed)) {
    Ok(v) => v
    Err(message) => return Err(message)
  }
  if next <= current {
    Err(
      "version \{next} is not above the current version \{current}; nothing to release, or pass a higher version",
    )
  } else {
    Ok(next)
  }
}

///|
/// Collapse runs of blank lines to one and end the text with one line break.
/// `git cliff --prepend` leaves extra blank lines between sections.
fn tidy_changelog(text : String) -> String {
  let out = StringBuilder()
  let mut blank = 0
  let mut started = false
  for line in text.split("\n") {
    let line = line.trim_end()
    if line.is_empty() {
      blank += 1
      continue
    }
    if started && blank > 0 {
      out.write_string("\n")
    }
    out.write_view(line)
    out.write_string("\n")
    blank = 0
    started = true
  }
  out.to_string()
}

///|
/// The body of the CHANGELOG.md section `## [<version>] ...`, without its
/// heading, or `None` when there is no such section.
fn changelog_section(changelog : String, version : Version) -> String? {
  let heading = "## [\{version}]"
  let body : Array[String] = []
  let mut inside = false
  for line in changelog.split("\n") {
    if line.has_prefix("## [") {
      if inside {
        break
      }
      inside = line.has_prefix(heading)
      continue
    }
    if inside {
      body.push(line.to_owned())
    }
  }
  if inside || !body.is_empty() {
    Some(tidy_changelog(body.join("\n")))
  } else {
    None
  }
}

///|
/// The GitHub release notes: an install line, then the changelog section.
fn release_notes(version : Version, section : String) -> String {
  let install = "**Install:** `moon add \{module_name}@\{version}` · [mooncakes.io](https://mooncakes.io/docs/\{module_name})"
  tidy_changelog(install + "\n\n" + section)
}

///|
/// The start of the comment that git-cliff writes where the highlights go
/// (cliff.toml).
let highlights_marker : String = "<!-- Highlights:"

///|
/// The section has its highlights: the placeholder comment is gone.
fn has_highlights(section : String) -> Bool {
  !section.contains(highlights_marker)
}

///|
/// What the Release workflow does for one run.
enum Plan {
  Release(Version)
  Skip(String)
} derive(Eq, Debug)

///|
/// Decide whether a Release run releases. A tag push must name the version in
/// moon.mod. Any other run (a push to main that changes moon.mod, a manual
/// run) releases when the version has no tag yet. A release needs its section
/// in CHANGELOG.md, with the highlights written.
fn plan(
  ref_type : String,
  ref_name : String,
  version : Version,
  tag_exists : Bool,
  has_section : Bool,
  highlights? : Bool = true,
) -> Result[Plan, String] {
  let tag = "v\{version}"
  if ref_type == "tag" && ref_name != tag {
    return Err(
      "tag \{ref_name} does not match moon.mod version \{version} (\{tag})",
    )
  }
  if ref_type != "tag" && tag_exists {
    return Ok(Skip("\{tag} is already tagged; nothing to release"))
  }
  if !has_section {
    return Err(
      "CHANGELOG.md has no section for \{version}; release with `mise run release:prepare`",
    )
  }
  if !highlights {
    return Err(
      "the CHANGELOG.md section for \{version} still has the highlights placeholder; write the highlights on release/v\{version}, then merge",
    )
  }
  Ok(Release(version))
}

///|
/// Lines for $GITHUB_OUTPUT.
fn plan_outputs(p : Plan) -> String {
  match p {
    Release(v) => "release=true\nversion=\{v}\ntag=v\{v}\n"
    Skip(_) => "release=false\n"
  }
}

///|
/// The body of the release pull request.
fn pr_body(version : Version, notes : String) -> String {
  (
    $|Release \{module_name} \{version}.
    $|
    $|Before you merge, edit the highlights comment at the top of the
    $|`## [\{version}]` section in `CHANGELOG.md`: a few sentences on what this
    $|release brings. You can also reword the generated lines. Then run
    $|`mise run release:refresh` to update the preview below.
    $|
    $|When this pull request merges, the Release workflow tags the merge
    $|commit `v\{version}`, publishes to mooncakes.io and creates the GitHub
    $|release from the changelog section.
    $|
    $|## Release notes preview
    $|
  ) +
  notes
}

///|
/// `release:refresh` runs only on the release branch of the moon.mod version.
fn refresh_branch(branch : String, version : Version) -> Result[String, String] {
  let expected = "release/v\{version}"
  if branch == expected {
    Ok(branch)
  } else {
    Err("run release:refresh on \{expected}, not on \{branch}")
  }
}

///|
/// What `status` collects about the release state.
struct Facts {
  /// The version in moon.mod on origin/main.
  main_version : Version
  /// The highest `vX.Y.Z` tag on origin.
  latest_tag : Version?
  /// `v<main_version>` is tagged.
  tagged : Bool
  /// `v<main_version>` has a GitHub release.
  github_release : Bool
  /// The latest version on mooncakes.io, or `None` when it cannot be read.
  mooncakes : Version?
  /// Commits on origin/main after the latest tag.
  unreleased : Int
  /// Head branches of open release pull requests.
  release_prs : Array[String]
}

///|
/// One line of the `status` report.
enum Finding {
  Good(String)
  Info(String)
  Problem(String)
} derive(Eq, Debug)

///|
fn finding_line(f : Finding) -> String {
  match f {
    Good(m) => "ok: \{m}"
    Info(m) => "info: \{m}"
    Problem(m) => "problem: \{m}"
  }
}

///|
/// Check that main, the tags, the GitHub release and mooncakes.io agree.
/// Each problem names the command that fixes it.
fn diagnose(f : Facts) -> Array[Finding] {
  let v = f.main_version
  let tag = "v\{v}"
  let out : Array[Finding] = []
  let published = match f.mooncakes {
    Some(m) => "mooncakes.io has \{m}"
    None => "mooncakes.io could not be read"
  }
  if f.tagged {
    let on_mooncakes = f.mooncakes is Some(m) && m == v
    if !f.github_release {
      out.push(
        Problem(
          "\{tag} is tagged but has no GitHub release; run `gh workflow run release.yml --ref \{tag}`",
        ),
      )
    }
    if !on_mooncakes {
      out.push(
        Problem(
          "\{tag} is tagged but \{published}; run `gh workflow run release.yml --ref \{tag}`",
        ),
      )
    }
    if f.github_release && on_mooncakes {
      out.push(Good("\{tag} is released: tag, GitHub release and mooncakes.io"))
    }
  } else {
    match f.latest_tag {
      Some(t) if v <= t =>
        out.push(
          Problem(
            "moon.mod on main is \{v} but the latest tag is v\{t}; set moon.mod to the released version or release a higher one",
          ),
        )
      Some(_) =>
        out.push(
          Problem(
            "moon.mod on main is \{v} but \{tag} has no tag (\{published}); check the latest Release run (`gh run list --workflow release.yml`), fix the cause, then run `gh workflow run release.yml --ref main`",
          ),
        )
      None =>
        out.push(Info("nothing is released yet; moon.mod on main is \{v}"))
    }
  }
  if f.unreleased > 0 {
    let since = match f.latest_tag {
      Some(t) => " since v\{t}"
      None => ""
    }
    out.push(Info("\{f.unreleased} commits on main\{since}"))
  }
  match f.release_prs {
    [] => ()
    [one] => out.push(Info("open release pull request: \{one}"))
    many =>
      out.push(
        Problem(
          "more than one open release pull request (\{many.join(", ")}); close all but one",
        ),
      )
  }
  out
}

///|
/// The highest `vX.Y.Z` among tag names.
fn latest_version(tags : Array[String]) -> Version? {
  let mut best : Version? = None
  for t in tags {
    guard t.trim().has_prefix("v") else { continue }
    guard parse_version(t) is Ok(v) else { continue }
    match best {
      Some(b) if b >= v => ()
      _ => best = Some(v)
    }
  }
  best
}

///|
/// The `version` of a mooncakes.io module API answer.
fn mooncakes_version(text : String) -> Version? {
  let json = @json.parse(text) catch { _ => return None }
  guard json is { "version": String(v), .. } else { return None }
  parse_version(v).to_option()
}

///|
fn fail_with(message : String) -> Unit {
  eprintln(message)
  @sys.exit(1)
}

///|
/// Run a command; stop the script when it fails.
async fn run_or_fail(
  cmd : String,
  args : Array[String],
  extra_env? : Map[String, String] = {},
) -> Unit {
  let code = @process.run(cmd, args, extra_env~)
  if code != 0 {
    fail_with("`\{cmd} \{args.join(" ")}` failed with exit code \{code}")
  }
}

///|
async fn stdout_of(cmd : String, args : Array[String]) -> (Int, String) {
  let (code, out) = @process.collect_stdout(
    cmd,
    args,
    stderr=@process.redirect_to_file("/dev/null"),
  ) catch {
    _ => (1, b"")
  }
  (code, out.text())
}

///|
async fn computed_version() -> String {
  let (code, out) = stdout_of("git", ["cliff", "--bumped-version"])
  choose_version(code, out)
}

///|
async fn current_version() -> String {
  match mod_version(@fs.read_file("moon.mod").text()) {
    Some(v) => v
    None => {
      fail_with("moon.mod has no version")
      ""
    }
  }
}

///|
/// GitHub token for git-cliff's PR numbers and authors.
async fn github_env() -> Map[String, String] {
  if @env.get_env_var("GITHUB_TOKEN") is Some(t) && t != "" {
    return {}
  }
  let (code, token) = stdout_of("gh", ["auth", "token"])
  if code == 0 && token.trim() != "" {
    { "GITHUB_TOKEN": token.trim().to_owned() }
  } else {
    eprintln(
      "warning: no GITHUB_TOKEN and no `gh auth token`; PR links and authors may be missing",
    )
    {}
  }
}

///|
async fn prepare(requested : String?, local_only : Bool) -> Unit {
  let (_, dirty) = stdout_of("git", ["status", "--porcelain"])
  if dirty.trim() != "" {
    fail_with(
      "the working tree has changes; commit them or set them aside first",
    )
  }
  run_or_fail("git", ["fetch", "--tags", "origin", "main"])
  run_or_fail("git", ["switch", "--detach", "origin/main"])
  let computed = match requested {
    Some(_) => ""
    None => {
      let (code, out) = stdout_of("git", ["cliff", "--bumped-version"])
      if code != 0 || out.trim() == "" {
        fail_with(
          "git-cliff could not compute the next version; run `mise run release:prepare` so mise provides git-cliff",
        )
      }
      out
    }
  }
  let version = match release_version(requested, computed, current_version()) {
    Ok(v) => v
    Err(message) => {
      fail_with(message)
      return
    }
  }
  let tag = "v\{version}"
  let (tag_code, _) = stdout_of("git", [
    "rev-parse",
    "--quiet",
    "--verify",
    "refs/tags/\{tag}",
  ])
  if tag_code == 0 {
    fail_with("tag \{tag} already exists")
  }
  let branch = "release/\{tag}"
  run_or_fail("git", ["switch", "-c", branch])
  guard set_mod_version(@fs.read_file("moon.mod").text(), version) is Some(m) else {
    fail_with("moon.mod has no version")
    return
  }
  @fs.write_file("moon.mod", m)
  guard set_lib_version(@fs.read_file(lib_path).text(), version) is Some(lib) else {
    fail_with("\{lib_path} has no version function")
    return
  }
  @fs.write_file(lib_path, lib)
  run_or_fail(
    "git",
    ["cliff", "--unreleased", "--tag", tag, "--prepend", changelog_path],
    extra_env=github_env(),
  )
  let changelog = tidy_changelog(@fs.read_file(changelog_path).text())
  @fs.write_file(changelog_path, changelog)
  run_or_fail("git", ["add", "moon.mod", lib_path, changelog_path])
  run_or_fail("git", ["commit", "-m", "chore(release): \{tag}"])
  let notes = release_notes(
    version,
    changelog_section(changelog, version).unwrap_or(""),
  )
  if local_only {
    println(
      (
        $|Created branch \{branch} with the release commit. Edit the highlights in
        $|CHANGELOG.md, then push the branch and open a pull request titled
        $|"chore(release): \{tag}".
      ),
    )
    return
  }
  run_or_fail("git", ["push", "--set-upstream", "origin", branch])
  run_or_fail("gh", [
    "pr",
    "create",
    "--base",
    "main",
    "--head",
    branch,
    "--title",
    "chore(release): \{tag}",
    "--body",
    pr_body(version, notes),
  ])
  println(
    "Opened the release pull request. Edit the highlights in CHANGELOG.md on \{branch}, then merge.",
  )
}

///|
async fn run_plan() -> Unit {
  let version = match parse_version(current_version()) {
    Ok(v) => v
    Err(message) => {
      fail_with(message)
      return
    }
  }
  let ref_type = @env.get_env_var("GITHUB_REF_TYPE").unwrap_or("")
  let ref_name = @env.get_env_var("GITHUB_REF_NAME").unwrap_or("")
  // Exit code 2: no such tag on origin.
  let (code, _) = stdout_of("git", [
    "ls-remote",
    "--exit-code",
    "--tags",
    "origin",
    "refs/tags/v\{version}",
  ])
  let changelog = if @fs.exists(changelog_path) {
    @fs.read_file(changelog_path).text()
  } else {
    ""
  }
  let section = changelog_section(changelog, version)
  let has_section = section is Some(_)
  let highlights = section.map(has_highlights).unwrap_or(true)
  match plan(ref_type, ref_name, version, code == 0, has_section, highlights~) {
    Err(message) => fail_with(message)
    Ok(p) => {
      match p {
        Release(v) => println("Release \{v}")
        Skip(reason) => println(reason)
      }
      match @env.get_env_var("GITHUB_OUTPUT") {
        Some(path) if path != "" =>
          @fs.write_file(path, plan_outputs(p), append=true)
        _ => println(plan_outputs(p).trim_end())
      }
    }
  }
}

///|
async fn notes(version : String) -> Unit {
  let version = match parse_version(version) {
    Ok(v) => v
    Err(message) => {
      fail_with(message)
      return
    }
  }
  match changelog_section(@fs.read_file(changelog_path).text(), version) {
    Some(section) => println(release_notes(version, section).trim_end())
    None => fail_with("CHANGELOG.md has no section for \{version}")
  }
}

///|
/// Update the body of the open release pull request from CHANGELOG.md, after
/// the highlights commit.
async fn refresh() -> Unit {
  let version = match parse_version(current_version()) {
    Ok(v) => v
    Err(message) => {
      fail_with(message)
      return
    }
  }
  let (_, branch) = stdout_of("git", ["branch", "--show-current"])
  let branch = match refresh_branch(branch.trim().to_owned(), version) {
    Ok(b) => b
    Err(message) => {
      fail_with(message)
      return
    }
  }
  guard changelog_section(@fs.read_file(changelog_path).text(), version)
    is Some(section) else {
    fail_with("CHANGELOG.md has no section for \{version}")
    return
  }
  if !has_highlights(section) {
    eprintln(
      "warning: the section for \{version} still has the highlights placeholder",
    )
  }
  run_or_fail("gh", [
    "pr",
    "edit",
    branch,
    "--body",
    pr_body(version, release_notes(version, section)),
  ])
  println("Updated the body of the release pull request for \{branch}.")
}

///|
async fn status() -> Unit {
  run_or_fail("git", ["fetch", "--quiet", "--tags", "origin", "main"])
  let (_, moon_mod) = stdout_of("git", ["show", "origin/main:moon.mod"])
  let main_version = match mod_version(moon_mod).map(parse_version) {
    Some(Ok(v)) => v
    _ => {
      fail_with("moon.mod on origin/main has no version")
      return
    }
  }
  let (_, tags) = stdout_of("git", ["tag", "--list", "v*"])
  let tag_names = tags.split("\n").map(t => t.to_owned()).collect()
  let latest_tag = latest_version(tag_names)
  let tag = "v\{main_version}"
  let tagged = tag_names.contains(tag)
  let (release_code, _) = stdout_of("gh", ["release", "view", tag])
  let (_, api) = stdout_of("curl", [
    "-fsS",
    "https://mooncakes.io/api/v0/modules/\{module_name}",
  ])
  let unreleased = match latest_tag {
    Some(t) => {
      let (_, count) = stdout_of("git", [
        "rev-list",
        "--count",
        "v\{t}..origin/main",
      ])
      count.trim().to_owned()
    }
    None => {
      let (_, count) = stdout_of("git", ["rev-list", "--count", "origin/main"])
      count.trim().to_owned()
    }
  }
  let (_, prs) = stdout_of("gh", [
    "pr", "list", "--state", "open", "--json", "headRefName", "--jq", ".[].headRefName",
  ])
  let release_prs = prs
    .split("\n")
    .filter(b => b.has_prefix("release/v"))
    .map(b => b.to_owned())
    .collect()
  let findings = diagnose({
    main_version,
    latest_tag,
    tagged,
    github_release: release_code == 0,
    mooncakes: mooncakes_version(api),
    unreleased: parse_number(unreleased).unwrap_or(0),
    release_prs,
  })
  for f in findings {
    println(finding_line(f))
  }
  let (_, run) = stdout_of("gh", [
    "run", "list", "--workflow", "release.yml", "--limit", "1", "--json", "status,conclusion,event,headBranch,url",
    "--jq", ".[] | \"latest Release run: \\(.event) on \\(.headBranch), \\(.status) \\(.conclusion) \\(.url)\"",
  ])
  if run.trim() != "" {
    println("info: \{run.trim()}")
  }
  if findings.iter().any(f => f is Problem(_)) {
    @sys.exit(1)
  }
}

///|
async fn main {
  match @env.args()[1:] {
    ["version"] => println(computed_version())
    ["prepare"] => prepare(None, false)
    ["prepare", "--local"] => prepare(None, true)
    ["prepare", version] => prepare(Some(version), false)
    ["prepare", version, "--local"] | ["prepare", "--local", version] =>
      prepare(Some(version), true)
    ["plan"] => run_plan()
    ["notes", version] => notes(version)
    ["refresh"] => refresh()
    ["status"] => status()
    _ => {
      eprintln(usage)
      @sys.exit(2)
    }
  }
}

///|
/// Scenario state for `features/release.feature`.
struct ReleaseWorld {
  mut exit_code : Int
  mut stdout : String
  mut text : String
  mut result : Result[String, String]
  mut ref_type : String
  mut ref_name : String
  mut tag_exists : Bool
  mut has_section : Bool
  mut highlights : Bool
  mut facts : Facts
}

///|
fn ReleaseWorld::new() -> ReleaseWorld {
  {
    exit_code: 0,
    stdout: "",
    text: "",
    result: Err("not run"),
    ref_type: "",
    ref_name: "",
    tag_exists: false,
    has_section: true,
    highlights: true,
    facts: {
      main_version: { major: 0, minor: 0, patch: 0, },
      latest_tag: None,
      tagged: false,
      github_release: false,
      mooncakes: None,
      unreleased: 0,
      release_prs: [],
    },
  }
}

///|
fn version_of(text : String) -> Version raise {
  match parse_version(text) {
    Ok(v) => v
    Err(message) => fail(message)
  }
}

///|
fn plan_name(r : Result[Plan, String]) -> String {
  match r {
    Ok(Release(v)) => "release \{v}"
    Ok(Skip(reason)) => "skip: \{reason}"
    Err(message) => "error: \{message}"
  }
}

///|
impl @moonspec.World for ReleaseWorld with fn configure(self, setup) {
  setup.given2("git-cliff exits with {int} and prints {string}", fn(
    code : Int,
    stdout : String,
  ) {
    self.exit_code = code
    self.stdout = stdout
  })
  setup.then1("the printed version is {string}", fn(expected : String) raise {
    @expect.expect(choose_version(self.exit_code, self.stdout)).to_equal(
      expected,
    )
  })
  setup.when1("I read the version {string}", fn(text : String) {
    self.result = match parse_version(text) {
      Ok(v) => Ok("\{v}")
      Err(message) => Err(message)
    }
  })
  setup.when3(
    "I choose the release version with request {string}, computed {string} and current {string}",
    fn(requested : String, computed : String, current : String) {
      let requested = if requested == "" { None } else { Some(requested) }
      self.result = match release_version(requested, computed, current) {
        Ok(v) => Ok("\{v}")
        Err(message) => Err(message)
      }
    },
  )
  setup.then1("the version is {string}", fn(expected : String) raise {
    @expect.expect(self.result).to_equal(Ok(expected))
  })
  setup.then1("it fails with {string}", fn(expected : String) raise {
    @expect.expect(self.result).to_equal(Err(expected))
  })
  setup.given1("the text:", fn(doc : @moonspec.DocString) {
    self.text = doc.content
  })
  setup.when1("I set the module version to {string}", fn(
    version : String,
  ) raise {
    self.result = match set_mod_version(self.text, version_of(version)) {
      Some(m) => Ok(m)
      None => Err("no version")
    }
  })
  setup.then1("moon.mod becomes:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(self.result).to_equal(Ok(doc.content))
  })
  setup.then0("the module has no version line", fn() raise {
    @expect.expect(self.result).to_equal(Err("no version"))
  })
  setup.when1("I set the library version to {string}", fn(
    version : String,
  ) raise {
    self.result = match set_lib_version(self.text, version_of(version)) {
      Some(lib) => Ok(lib)
      None => Err("no version function")
    }
  })
  setup.then1("the library file becomes:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(self.result).to_equal(Ok(doc.content))
  })
  setup.then0("the library has no version function", fn() raise {
    @expect.expect(self.result).to_equal(Err("no version function"))
  })
  setup.when0("I tidy the changelog", fn() {
    self.result = Ok(tidy_changelog(self.text))
  })
  setup.when1("I take the changelog section for {string}", fn(
    version : String,
  ) raise {
    self.result = match changelog_section(self.text, version_of(version)) {
      Some(s) => Ok(s)
      None => Err("no section")
    }
  })
  setup.when1("I make the release notes for {string}", fn(
    version : String,
  ) raise {
    self.result = Ok(release_notes(version_of(version), self.text))
  })
  setup.then1("the result is:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(self.result).to_equal(Ok(doc.content + "\n"))
  })
  setup.then0("the section is empty", fn() raise {
    @expect.expect(self.result).to_equal(Ok(""))
  })
  setup.then0("there is no section", fn() raise {
    @expect.expect(self.result).to_equal(Err("no section"))
  })
  setup.given2("the ref type is {string} and the ref name is {string}", fn(
    ref_type : String,
    ref_name : String,
  ) {
    self.ref_type = ref_type
    self.ref_name = ref_name
  })
  setup.given1("the tag exists: {string}", fn(answer : String) {
    self.tag_exists = answer == "yes"
  })
  setup.given1("the changelog has the section: {string}", fn(answer : String) {
    self.has_section = answer == "yes"
  })
  setup.then2("the plan for version {string} is {string}", fn(
    version : String,
    expected : String,
  ) raise {
    let r = plan(
      self.ref_type,
      self.ref_name,
      version_of(version),
      self.tag_exists,
      self.has_section,
      highlights=self.highlights,
    )
    @expect.expect(plan_name(r)).to_equal(expected)
  })
  setup.given1("the changelog section has highlights: {string}", fn(
    answer : String,
  ) {
    self.highlights = answer == "yes"
  })
  setup.then1("the section has highlights: {string}", fn(
    expected : String,
  ) raise {
    let actual = if has_highlights(self.text) { "yes" } else { "no" }
    @expect.expect(actual).to_equal(expected)
  })
  setup.then3(
    "refreshing on branch {string} for version {string} gives {string}",
    fn(branch : String, version : String, expected : String) raise {
      let actual = match refresh_branch(branch, version_of(version)) {
        Ok(b) => "ok: \{b}"
        Err(message) => "error: \{message}"
      }
      @expect.expect(actual).to_equal(expected)
    },
  )
  setup.then2("the pull request body for {string} mentions {string}", fn(
    version : String,
    text : String,
  ) raise {
    @expect.expect(pr_body(version_of(version), "")).to_contain(text)
  })
  setup.then2("the outputs for a release of {string} are:", fn(
    version : String,
    doc : @moonspec.DocString,
  ) raise {
    @expect.expect(plan_outputs(Release(version_of(version)))).to_equal(
      doc.content + "\n",
    )
  })
  setup.given2("moon.mod on main is {string} and the latest tag is {string}", fn(
    main : String,
    latest : String,
  ) raise {
    self.facts = {
      ..self.facts,
      main_version: version_of(main),
      latest_tag: if latest == "" {
        None
      } else {
        Some(version_of(latest))
      },
    }
  })
  setup.given3(
    "the main version is tagged: {string}, has a GitHub release: {string}, mooncakes.io has {string}",
    fn(tagged : String, release : String, mooncakes : String) raise {
      self.facts = {
        ..self.facts,
        tagged: tagged == "yes",
        github_release: release == "yes",
        mooncakes: if mooncakes == "" {
          None
        } else {
          Some(version_of(mooncakes))
        },
      }
    },
  )
  setup.given2("{int} unreleased commits and release pull requests {string}", fn(
    n : Int,
    prs : String,
  ) {
    self.facts = {
      ..self.facts,
      unreleased: n,
      release_prs: if prs == "" {
        []
      } else {
        prs.split(",").map(b => b.trim().to_owned()).collect()
      },
    }
  })
  setup.then1("the status report is:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(diagnose(self.facts).map(finding_line).join("\n")).to_equal(
      doc.content,
    )
  })
  setup.then2("the latest version of tags {string} is {string}", fn(
    tags : String,
    expected : String,
  ) raise {
    let names = tags.split(" ").map(t => t.to_owned()).collect()
    let actual = match latest_version(names) {
      Some(v) => "\{v}"
      None => "none"
    }
    @expect.expect(actual).to_equal(expected)
  })
  setup.then1("the mooncakes.io version is {string}", fn(
    expected : String,
  ) raise {
    let actual = match mooncakes_version(self.text) {
      Some(v) => "\{v}"
      None => "none"
    }
    @expect.expect(actual).to_equal(expected)
  })
}

///|
async test "release feature" {
  @moonspec.run_or_fail(
    ReleaseWorld::new,
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/release.feature"),
    ]),
  )
  |> ignore
}
