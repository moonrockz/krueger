import {
  "moonrockz/krueger",
  "moonrockz/krueger/ast",
  "moonrockz/krueger/lawkit",
  "moonrockz/moonspec/async" @moonspec,
  "moonrockz/expect",
  "moonbitlang/async",
  "moonbitlang/x/fs",
  "moonbitlang/x/crypto",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

// moonspec 0.12.0 runs async tests through moonrockz/moonspec/async, which
// supports these targets only (no wasm-gc). The harness runs on js.

supported_targets = "wasm+js+native"
