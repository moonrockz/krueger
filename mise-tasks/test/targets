#!/usr/bin/env bash
#MISE description="Check and test the library on every supported MoonBit target"
set -euo pipefail
# llvm is left out: the toolchain does not ship moonbitlang/core for it.
for target in wasm wasm-gc js native; do
  moon check --target "$target"
  for pkg in src src/dialect src/scanner src/parser src/report src/ast src/cst; do
    moon test "$pkg" --target "$target"
  done
done
